<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^account-deletion/?$ account-deletion.html [L]
  RewriteRule ^delete-account/?$ account-deletion.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
